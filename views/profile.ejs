<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= profileUser.username %> — Profile</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Space Grotesk', sans-serif; }
        .mono { font-family: 'JetBrains Mono', monospace; }
        .nav-link { transition: color 0.15s ease, background 0.15s ease; }
        .nav-link:hover { color: #5eead4; background: rgba(13,148,136,0.1); }
        .tab-active { border-bottom: 2px solid #0d9488; color: #0d9488; }
        .badge-pill { display: inline-flex; align-items: center; gap: 4px; }
        .avatar-wrapper:hover .avatar-overlay { opacity: 1; }
        .avatar-overlay { opacity: 0; transition: opacity 0.2s ease; }
    </style>
</head>
<body class="bg-gray-950 text-gray-100 min-h-screen flex flex-col">
    <%- include('partials/header') %>

    <main class="max-w-4xl mx-auto px-6 py-10 flex-1 w-full">

        <!-- Profile Header -->
        <div class="bg-gray-900 border border-gray-800 rounded-2xl p-8 mb-6">
            <div class="flex items-start justify-between">
                <div class="flex items-center gap-5">

                    <!-- Avatar with upload overlay -->
                    <div class="relative avatar-wrapper cursor-pointer">
                        <% if (profileUser.avatar) { %>
                            <img src="<%= profileUser.avatar %>"
                                id="avatar-img"
                                class="w-20 h-20 rounded-2xl object-cover border-2 border-teal-500/30 shadow-lg shadow-teal-900/40"
                                alt="avatar" />
                        <% } else { %>
                            <div id="avatar-img"
                                class="w-20 h-20 rounded-2xl bg-gradient-to-br from-teal-500 to-cyan-600 flex items-center justify-center text-white text-3xl font-bold mono shadow-lg shadow-teal-900/40">
                                <%= profileUser.username.charAt(0).toUpperCase() %>
                            </div>
                        <% } %>

                        <!-- Upload overlay — only show on own profile -->
                        <% if (isOwnProfile) { %>
                            <label for="avatar-input"
                                class="avatar-overlay absolute inset-0 rounded-2xl bg-black/60 flex flex-col items-center justify-center cursor-pointer gap-1">
                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2">
                                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                                    <polyline points="17 8 12 3 7 8"/>
                                    <line x1="12" y1="3" x2="12" y2="15"/>
                                </svg>
                                <span class="text-white text-xs">Upload</span>
                            </label>
                            <input type="file" id="avatar-input" accept="image/*" class="hidden" onchange="uploadAvatar(event)" />
                        <% } %>
                    </div>

                    <!-- Info -->
                    <div>
                        <h1 class="text-2xl font-semibold text-white"><%= profileUser.username %></h1>
                        <p class="text-gray-500 text-sm mt-1 mono">
                            Joined <span data-joined="<%= profileUser.joinedAt %>"></span>
                        </p>
                        <% if (profileUser.bio) { %>
                            <p class="text-gray-300 text-sm mt-2"><%= profileUser.bio %></p>
                        <% } else { %>
                            <p class="text-gray-600 text-sm mt-2 italic">No bio yet.</p>
                        <% } %>

                        <!-- Badges -->
                        <% if (profileUser.badges && profileUser.badges.length > 0) { %>
                            <div class="flex flex-wrap gap-2 mt-3">
                                <% profileUser.badges.forEach(badge => { %>
                                    <span class="badge-pill text-xs px-2 py-1 rounded-full mono
                                        <%= badge === 'Legend' ? 'bg-yellow-500/20 text-yellow-400 border border-yellow-500/30' :
                                           badge === 'Rising Star' ? 'bg-purple-500/20 text-purple-400 border border-purple-500/30' :
                                           badge === 'Popular' ? 'bg-teal-500/20 text-teal-400 border border-teal-500/30' :
                                           'bg-gray-700 text-gray-400 border border-gray-600' %>">
                                        <%= badge === 'Legend' ? '👑' :
                                           badge === 'Rising Star' ? '⭐' :
                                           badge === 'Popular' ? '🔥' : '🎯' %>
                                        <%= badge %>
                                    </span>
                                <% }) %>
                            </div>
                        <% } %>
                    </div>
                </div>

                <!-- Follow / Edit buttons -->
                <div class="flex flex-col items-end gap-3">
                    <% if (!isOwnProfile) { %>
                        <button
                            onclick="toggleFollow('<%= profileUser._id %>')"
                            id="follow-btn"
                            class="<%= isFollowing ? 'border border-gray-700 text-gray-400 hover:border-red-500 hover:text-red-400' : 'bg-gradient-to-r from-teal-600 to-cyan-600 text-white' %> text-sm px-5 py-2 rounded-xl cursor-pointer transition-all mono">
                            <%= isFollowing ? 'Following' : 'Follow' %>
                        </button>
                    <% } else { %>
                        <button onclick="toggleEditBio()"
                            class="border border-gray-700 text-gray-400 text-sm px-5 py-2 rounded-xl cursor-pointer hover:border-teal-500 hover:text-teal-400 transition-colors mono">
                            Edit Bio
                        </button>
                    <% } %>
                </div>
            </div>

            <!-- Upload status message -->
            <div id="upload-status" class="hidden mt-3 text-sm mono"></div>

            <!-- Edit Bio Form -->
            <% if (isOwnProfile) { %>
                <form action="/profile/update" method="POST"
                    id="bio-form"
                    class="hidden mt-5 flex flex-col gap-3">
                    <textarea
                        name="bio"
                        rows="2"
                        maxlength="160"
                        placeholder="Write a short bio..."
                        class="w-full bg-gray-800 border border-gray-700 text-gray-200 rounded-xl px-4 py-3 text-sm resize-none focus:outline-none focus:border-teal-500"><%= profileUser.bio %></textarea>
                    <div class="flex gap-2">
                        <button type="submit"
                            class="bg-gradient-to-r from-teal-600 to-cyan-600 text-white text-xs px-4 py-2 rounded-lg cursor-pointer">
                            Save
                        </button>
                        <button type="button" onclick="toggleEditBio()"
                            class="border border-gray-700 text-gray-400 text-xs px-4 py-2 rounded-lg cursor-pointer">
                            Cancel
                        </button>
                    </div>
                </form>
            <% } %>

            <!-- Stats Row -->
            <div class="grid grid-cols-4 gap-4 mt-6 pt-6 border-t border-gray-800">
                <div class="text-center">
                    <p class="text-2xl font-bold text-teal-400 mono"><%= profileUser.reputation || 0 %></p>
                    <p class="text-gray-500 text-xs mt-1">Reputation</p>
                </div>
                <div class="text-center">
                    <p class="text-2xl font-bold text-white mono"><%= messages.length %></p>
                    <p class="text-gray-500 text-xs mt-1">Messages</p>
                </div>
                <div class="text-center">
                    <p class="text-2xl font-bold text-white mono"><%= profileUser.followers ? profileUser.followers.length : 0 %></p>
                    <p class="text-gray-500 text-xs mt-1">Followers</p>
                </div>
                <div class="text-center">
                    <p class="text-2xl font-bold text-white mono"><%= profileUser.following ? profileUser.following.length : 0 %></p>
                    <p class="text-gray-500 text-xs mt-1">Following</p>
                </div>
            </div>
        </div>

        <!-- Tabs -->
        <div class="flex gap-6 border-b border-gray-800 mb-6">
            <button onclick="showTab('messages')" id="tab-messages"
                class="tab-active text-sm pb-3 px-1 font-medium cursor-pointer transition-colors">
                Messages
            </button>
            <button onclick="showTab('topics')" id="tab-topics"
                class="text-gray-500 text-sm pb-3 px-1 font-medium cursor-pointer hover:text-gray-300 transition-colors">
                Topics
            </button>
            <button onclick="showTab('followers')" id="tab-followers"
                class="text-gray-500 text-sm pb-3 px-1 font-medium cursor-pointer hover:text-gray-300 transition-colors">
                Followers
            </button>
            <button onclick="showTab('following')" id="tab-following"
                class="text-gray-500 text-sm pb-3 px-1 font-medium cursor-pointer hover:text-gray-300 transition-colors">
                Following
            </button>
        </div>

        <!-- Messages Tab -->
        <div id="content-messages">
            <% if (messages.length === 0) { %>
                <div class="border border-dashed border-gray-700 rounded-2xl p-12 text-center">
                    <p class="text-gray-600 mono text-xs mb-2">// no messages yet</p>
                    <p class="text-gray-400">No messages posted yet.</p>
                </div>
            <% } else { %>
                <div class="flex flex-col gap-3">
                    <% messages.forEach(message => { %>
                        <div class="bg-gray-900 border border-gray-800 rounded-xl p-5 hover:border-gray-700 transition-colors">
                            <div class="flex items-center justify-between mb-2">
                                <a href="/topics/<%= message.topic._id %>"
                                    class="text-teal-400 text-sm hover:text-teal-300 transition-colors">
                                    in <%= message.topic.title %>
                                </a>
                                <span class="text-gray-600 mono text-xs"
                                    data-time="<%= message.createdAt %>">
                                </span>
                            </div>
                            <p class="text-gray-300 text-sm"><%= message.content %></p>
                            <div class="flex items-center gap-3 mt-3">
                                <span class="text-xs text-gray-600 mono">
                                    👍 <%= message.upvotes ? message.upvotes.length : 0 %>
                                </span>
                                <span class="text-xs text-gray-600 mono">
                                    👎 <%= message.downvotes ? message.downvotes.length : 0 %>
                                </span>
                            </div>
                        </div>
                    <% }) %>
                </div>
            <% } %>
        </div>

        <!-- Topics Tab -->
        <div id="content-topics" class="hidden">
            <% if (topics.length === 0) { %>
                <div class="border border-dashed border-gray-700 rounded-2xl p-12 text-center">
                    <p class="text-gray-600 mono text-xs mb-2">// no topics yet</p>
                    <p class="text-gray-400">No topics created yet.</p>
                </div>
            <% } else { %>
                <div class="flex flex-col gap-3">
                    <% topics.forEach(topic => { %>
                        <a href="/topics/<%= topic._id %>"
                            class="bg-gray-900 border border-gray-800 rounded-xl p-5 hover:border-teal-500/50 transition-colors block">
                            <h3 class="text-white font-medium"><%= topic.title %></h3>
                            <p class="text-gray-500 text-sm mt-1"><%= topic.description %></p>
                            <div class="flex items-center gap-4 mt-3">
                                <span class="mono text-xs text-gray-600"><%= topic.subscribers ? topic.subscribers.length : 0 %> subscribers</span>
                                <span class="mono text-xs text-gray-600"><%= topic.accessCount || 0 %> views</span>
                            </div>
                        </a>
                    <% }) %>
                </div>
            <% } %>
        </div>

        <!-- Followers Tab -->
        <div id="content-followers" class="hidden">
            <% if (!profileUser.followers || profileUser.followers.length === 0) { %>
                <div class="border border-dashed border-gray-700 rounded-2xl p-12 text-center">
                    <p class="text-gray-600 mono text-xs mb-2">// no followers yet</p>
                    <p class="text-gray-400">No followers yet.</p>
                </div>
            <% } else { %>
                <div class="grid grid-cols-2 gap-3">
                    <% profileUser.followers.forEach(follower => { %>
                        <a href="/profile/<%= follower.username %>"
                            class="bg-gray-900 border border-gray-800 rounded-xl p-4 flex items-center gap-3 hover:border-teal-500/50 transition-colors">
                            <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-teal-500 to-cyan-600 flex items-center justify-center text-white font-bold mono text-sm">
                                <%= follower.username.charAt(0).toUpperCase() %>
                            </div>
                            <span class="text-white text-sm font-medium"><%= follower.username %></span>
                        </a>
                    <% }) %>
                </div>
            <% } %>
        </div>

        <!-- Following Tab -->
        <div id="content-following" class="hidden">
            <% if (!profileUser.following || profileUser.following.length === 0) { %>
                <div class="border border-dashed border-gray-700 rounded-2xl p-12 text-center">
                    <p class="text-gray-600 mono text-xs mb-2">// not following anyone</p>
                    <p class="text-gray-400">Not following anyone yet.</p>
                </div>
            <% } else { %>
                <div class="grid grid-cols-2 gap-3">
                    <% profileUser.following.forEach(followedUser => { %>
                        <a href="/profile/<%= followedUser.username %>"
                            class="bg-gray-900 border border-gray-800 rounded-xl p-4 flex items-center gap-3 hover:border-teal-500/50 transition-colors">
                            <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-teal-500 to-cyan-600 flex items-center justify-center text-white font-bold mono text-sm">
                                <%= followedUser.username.charAt(0).toUpperCase() %>
                            </div>
                            <span class="text-white text-sm font-medium"><%= followedUser.username %></span>
                        </a>
                    <% }) %>
                </div>
            <% } %>
        </div>

    </main>

    <%- include('partials/footer') %>

    <script>
        // ── Timezone fix ──────────────────────────────────────
        function formatLocalTime(dateString) {
            return new Date(dateString).toLocaleString(undefined, {
                year: 'numeric',
                month: 'numeric',
                day: 'numeric',
                hour: 'numeric',
                minute: '2-digit',
                hour12: true
            });
        }

        function convertAllTimes() {
            // Regular timestamps
            document.querySelectorAll('[data-time]').forEach(el => {
                const raw = el.getAttribute('data-time');
                if (raw) el.textContent = formatLocalTime(raw);
            });

            // Joined date — show only month and year
            document.querySelectorAll('[data-joined]').forEach(el => {
                const raw = el.getAttribute('data-joined');
                if (raw) {
                    el.textContent = new Date(raw).toLocaleDateString(undefined, {
                        month: 'long',
                        year: 'numeric'
                    });
                }
            });
        }

        document.addEventListener('DOMContentLoaded', convertAllTimes);

        // ── Tab switching ─────────────────────────────────────
        function showTab(tab) {
            const tabs = ['messages', 'topics', 'followers', 'following'];
            tabs.forEach(t => {
                document.getElementById(`content-${t}`).classList.add('hidden');
                document.getElementById(`tab-${t}`).classList.remove('tab-active');
                document.getElementById(`tab-${t}`).classList.add('text-gray-500');
            });
            document.getElementById(`content-${tab}`).classList.remove('hidden');
            document.getElementById(`tab-${tab}`).classList.add('tab-active');
            document.getElementById(`tab-${tab}`).classList.remove('text-gray-500');
        }

        // ── Edit bio ──────────────────────────────────────────
        function toggleEditBio() {
            const form = document.getElementById('bio-form');
            form.classList.toggle('hidden');
        }

        // ── Follow / Unfollow ─────────────────────────────────
        async function toggleFollow(userId) {
            try {
                const res = await fetch(`/users/${userId}/follow`, { method: 'POST' });
                const data = await res.json();
                const btn = document.getElementById('follow-btn');
                if (data.action === 'followed') {
                    btn.textContent = 'Following';
                    btn.className = 'border border-gray-700 text-gray-400 hover:border-red-500 hover:text-red-400 text-sm px-5 py-2 rounded-xl cursor-pointer transition-all mono';
                } else {
                    btn.textContent = 'Follow';
                    btn.className = 'bg-gradient-to-r from-teal-600 to-cyan-600 text-white text-sm px-5 py-2 rounded-xl cursor-pointer transition-all mono';
                }
            } catch(err) {
                console.log('Follow error:', err);
            }
        }

        // ── Avatar Upload ─────────────────────────────────────
        async function uploadAvatar(event) {
            const file = event.target.files[0];
            if (!file) return;

            // Check file size max 2MB
            if (file.size > 2 * 1024 * 1024) {
                showStatus('❌ Image too large. Max size is 2MB.', 'text-red-400');
                return;
            }

            // Check file type
            if (!file.type.startsWith('image/')) {
                showStatus('❌ Please select an image file.', 'text-red-400');
                return;
            }

            showStatus('⏳ Uploading...', 'text-teal-400');

            // Convert to base64
            const reader = new FileReader();
            reader.onload = async (e) => {
                try {
                    const base64 = e.target.result;

                    const res = await fetch('/profile/avatar', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ avatar: base64 })
                    });

                    const data = await res.json();

                    if (data.success) {
                        showStatus('✅ Profile picture updated!', 'text-teal-400');

                        // Update avatar instantly on page
                        const wrapper = document.querySelector('.avatar-wrapper');
                        const oldAvatar = document.getElementById('avatar-img');
                        const newImg = document.createElement('img');
                        newImg.src = base64;
                        newImg.id = 'avatar-img';
                        newImg.className = 'w-20 h-20 rounded-2xl object-cover border-2 border-teal-500/30 shadow-lg shadow-teal-900/40';
                        newImg.alt = 'avatar';
                        oldAvatar.replaceWith(newImg);

                        // Reload after 1.5 seconds
                        setTimeout(() => window.location.reload(), 1500);
                    } else {
                        showStatus('❌ Upload failed. Try again.', 'text-red-400');
                    }
                } catch(err) {
                    showStatus('❌ Upload failed. Try again.', 'text-red-400');
                }
            };
            reader.readAsDataURL(file);
        }

        function showStatus(msg, colorClass) {
            const el = document.getElementById('upload-status');
            el.textContent = msg;
            el.className = `mt-3 text-sm mono ${colorClass}`;
            el.classList.remove('hidden');
            setTimeout(() => el.classList.add('hidden'), 3000);
        }
    </script>

</body>
</html>