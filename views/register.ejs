<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Register</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Space Grotesk', sans-serif; }
        .mono { font-family: 'JetBrains Mono', monospace; }
        .input-field { background: #111827; border: 1px solid #1f2937; color: #f3f4f6; transition: border-color 0.15s ease, box-shadow 0.15s ease; }
        .input-field:focus { outline: none; border-color: #6366f1; box-shadow: 0 0 0 3px rgba(99,102,241,0.15); }
        .input-field::placeholder { color: #4b5563; }
        .submit-btn { transition: background 0.15s ease, transform 0.1s ease; }
        .submit-btn:hover { background: #4f46e5; }
        .submit-btn:active { transform: scale(0.98); }
    </style>
</head>
<body class="bg-gray-950 text-gray-100 min-h-screen flex items-center justify-center px-4">

    <div class="w-full max-w-md">

        <div class="text-center mb-10">
            <div class="w-12 h-12 rounded-xl bg-indigo-600 flex items-center justify-center text-white font-semibold mono text-lg mx-auto mb-4">MB</div>
            <h1 class="text-2xl font-semibold text-white">Create an account</h1>
            <p class="text-gray-500 text-sm mt-1">Join the message board</p>
        </div>

        <div class="bg-gray-900 border border-gray-800 rounded-2xl p-8">

            <% if (error) { %>
                <div class="bg-red-500/10 border border-red-500/20 text-red-400 text-sm rounded-lg px-4 py-3 mb-6 mono">
                    // <%= error %>
                </div>
            <% } %>

            <form action="/register" method="POST" class="flex flex-col gap-5">
                <div>
                    <label class="block text-gray-400 text-sm mb-2 mono">username</label>
                    <input type="text" name="username" required placeholder="yourname" class="input-field w-full rounded-lg px-4 py-3 text-sm" />
                </div>
                <div>
                    <label class="block text-gray-400 text-sm mb-2 mono">email</label>
                    <input type="email" name="email" required placeholder="you@example.com" class="input-field w-full rounded-lg px-4 py-3 text-sm" />
                </div>
                <div>
                    <label class="block text-gray-400 text-sm mb-2 mono">password</label>
                    <input type="password" name="password" required placeholder="••••••••" class="input-field w-full rounded-lg px-4 py-3 text-sm" />
                </div>
                <button type="submit" class="submit-btn bg-indigo-600 text-white font-medium text-sm py-3 rounded-lg mt-1 cursor-pointer">
                    Create account
                </button>
            </form>

        </div>

        <p class="text-center text-gray-600 text-sm mt-6">
            Already have an account? <a href="/login" class="text-indigo-400 hover:text-indigo-300 transition-colors">Login here</a>
        </p>

    </div>

</body>
</html>