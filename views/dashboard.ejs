<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Space Grotesk', sans-serif; }
        .mono { font-family: 'JetBrains Mono', monospace; }
        .card-hover { transition: border-color 0.2s ease, transform 0.2s ease; }
        .card-hover:hover { border-color: #0d9488; transform: translateY(-2px); }
        .nav-link { transition: color 0.15s ease, background 0.15s ease; }
        .nav-link:hover { color: #5eead4; background: rgba(13,148,136,0.1); }
        .unsub-btn { transition: background 0.15s ease, color 0.15s ease, border-color 0.15s ease; }
        .unsub-btn:hover { background: #ef4444; color: white; border-color: #ef4444; }
        .msg-item { border-left: 2px solid #1f2937; transition: border-color 0.15s ease; }
        .msg-item:hover { border-left-color: #0d9488; }
    </style>
</head>
<body class="bg-gray-950 text-gray-100 min-h-screen flex flex-col">

    <%- include('partials/header') %>

    <main class="max-w-5xl mx-auto px-6 py-10 flex-1 w-full">

        <div class="mb-10">
            <p class="text-teal-400 mono text-sm mb-1">welcome back</p>
            <h1 class="text-3xl font-semibold text-white"><%= username %><span class="text-gray-700 animate-pulse"> _</span></h1>
        </div>

        <div class="mb-6 flex items-center justify-between">
            <h2 class="text-lg font-medium text-gray-200">Subscribed Topics</h2>
            <span class="mono text-xs text-gray-500 bg-gray-800 px-3 py-1 rounded-full"><%= topicsWithMessages.length %> active</span>
        </div>

        <% if (topicsWithMessages.length === 0) { %>
            <div class="border border-dashed border-gray-700 rounded-2xl p-14 text-center">
                <p class="text-gray-600 mono text-xs mb-3">// no subscriptions found</p>
                <p class="text-gray-400 mb-6">You haven't subscribed to any topics yet.</p>
                <a href="/topics" class="inline-block bg-gradient-to-r from-teal-600 to-cyan-600 hover:opacity-90 text-white text-sm font-medium px-5 py-2.5 rounded-lg transition-opacity">
                    Browse Topics
                </a>
            </div>
        <% } else { %>
            <div class="flex flex-col gap-5">
                <% topicsWithMessages.forEach(({ topic, messages }) => { %>
                    <div class="card-hover border border-gray-800 bg-gray-900 rounded-2xl p-6">

                        <div class="flex items-start justify-between mb-4">
                            <div>
                                <a href="/topics/<%= topic._id %>" class="text-lg font-semibold text-white hover:text-teal-400 transition-colors">
                                    <%= topic.title %>
                                </a>
                                <p class="text-gray-500 text-sm mt-1"><%= topic.description %></p>
                            </div>
                            <form action="/topics/<%= topic._id %>/unsubscribe" method="POST">
                                <button type="submit" class="unsub-btn border border-gray-700 text-gray-400 text-xs px-3 py-1.5 rounded-lg mono ml-4 shrink-0 cursor-pointer">
                                    unsubscribe
                                </button>
                            </form>
                        </div>

                        <div class="border-t border-gray-800 pt-4">
                            <p class="text-xs mono text-gray-600 mb-3">recent messages</p>
                            <% if (messages.length === 0) { %>
                                <p class="text-gray-600 text-sm italic">No messages yet.</p>
                            <% } else { %>
                                <div class="flex flex-col gap-3">
                                    <% messages.forEach(message => { %>
                                        <div class="msg-item pl-4 py-1">
                                            <div class="flex items-center gap-2 mb-1">
                                                <span class="text-teal-400 text-sm font-medium"><%= message.author.username %></span>
                                                <span class="text-gray-600 mono text-xs"><%= new Date(message.createdAt).toLocaleString() %></span>
                                            </div>
                                            <p class="text-gray-300 text-sm"><%= message.content %></p>
                                        </div>
                                    <% }) %>
                                </div>
                            <% } %>
                        </div>

                    </div>
                <% }) %>
            </div>
        <% } %>

    </main>

    <%- include('partials/footer') %>

</body>
</html>