<header class="border-b border-gray-800 bg-gray-900/80 backdrop-blur-sm sticky top-0 z-10">
    <div class="max-w-5xl mx-auto px-6 py-4 flex items-center justify-between">
        <a href="/dashboard" class="flex items-center gap-3">
            <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-teal-500 to-cyan-600 flex items-center justify-center text-white text-sm font-semibold mono">MB</div>
            <span class="text-gray-400 text-sm">MessageBoard</span>
        </a>
        <div class="flex items-center gap-1">

            <a href="/topics" class="nav-link text-gray-300 text-sm px-4 py-2 rounded-lg">Browse Topics</a>
            <a href="/stats" class="nav-link text-gray-300 text-sm px-4 py-2 rounded-lg">Statistics</a>

            <!-- 🔔 Notification Bell -->
            <div class="relative" id="notif-wrapper">
                <button onclick="toggleNotifications()"
                    class="nav-link text-gray-300 text-sm px-4 py-2 rounded-lg flex items-center gap-2 cursor-pointer bg-transparent border-0">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"
                        fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/>
                        <path d="M13.73 21a2 2 0 0 1-3.46 0"/>
                    </svg>
                    <span id="notif-badge"
                        class="<%= (typeof unreadCount !== 'undefined' && unreadCount > 0) ? '' : 'hidden' %> inline-flex items-center justify-center w-5 h-5 text-xs font-bold text-white bg-red-500 rounded-full">
                        <%= (typeof unreadCount !== 'undefined' && unreadCount > 0) ? unreadCount : '' %>
                    </span>
                </button>

                <!-- Notification Dropdown -->
                <div id="notif-dropdown"
                    class="hidden absolute right-0 mt-2 w-80 bg-gray-900 border border-gray-700 rounded-xl shadow-2xl z-50">
                    <div class="flex items-center justify-between px-4 py-3 border-b border-gray-700">
                        <span class="text-white text-sm font-medium">Notifications</span>
                        <button onclick="markAllRead()"
                            class="text-teal-400 text-xs hover:text-teal-300 cursor-pointer bg-transparent border-0">
                            Mark all read
                        </button>
                    </div>
                    <div id="notif-list" class="max-h-80 overflow-y-auto">
                        <p class="text-gray-500 text-sm text-center py-6">Loading...</p>
                    </div>
                </div>
            </div>

            <!-- 👤 Profile Avatar Dropdown -->
            <div class="relative ml-2" id="profile-wrapper">
                <button onclick="toggleProfileMenu()"
                    class="flex items-center gap-2 cursor-pointer bg-transparent border-0 focus:outline-none">
                    <% if (typeof currentUser !== 'undefined' && currentUser && currentUser.avatar) { %>
                        <img src="<%= currentUser.avatar %>"
                            class="w-9 h-9 rounded-full object-cover border-2 border-teal-500/50 hover:border-teal-400 transition-colors"
                            alt="avatar" />
                    <% } else { %>
                        <div class="w-9 h-9 rounded-full bg-gradient-to-br from-teal-500 to-cyan-600 flex items-center justify-center text-white text-sm font-bold mono border-2 border-teal-500/30 hover:border-teal-400 transition-colors">
                            <%= (typeof username !== 'undefined' && username) ? username.charAt(0).toUpperCase() : '?' %>
                        </div>
                    <% } %>
                </button>

                <!-- Profile Dropdown Menu -->
                <div id="profile-dropdown"
                    class="hidden absolute right-0 mt-2 w-56 bg-gray-900 border border-gray-700 rounded-xl shadow-2xl z-50">

                    <!-- User info header -->
                    <div class="px-4 py-3 border-b border-gray-800">
                        <div class="flex items-center gap-3">
                            <% if (typeof currentUser !== 'undefined' && currentUser && currentUser.avatar) { %>
                                <img src="<%= currentUser.avatar %>"
                                    class="w-8 h-8 rounded-full object-cover"
                                    alt="avatar" />
                            <% } else { %>
                                <div class="w-8 h-8 rounded-full bg-gradient-to-br from-teal-500 to-cyan-600 flex items-center justify-center text-white text-xs font-bold mono">
                                    <%= (typeof username !== 'undefined' && username) ? username.charAt(0).toUpperCase() : '?' %>
                                </div>
                            <% } %>
                            <div>
                                <p class="text-white text-sm font-medium"><%= (typeof username !== 'undefined') ? username : '' %></p>
                                <% if (typeof currentUser !== 'undefined' && currentUser) { %>
                                    <p class="text-teal-400 text-xs mono"><%= currentUser.reputation || 0 %> rep</p>
                                <% } %>
                            </div>
                        </div>
                    </div>

                    <!-- Menu items -->
                    <div class="py-1">
                        <a href="/profile/<%= (typeof username !== 'undefined') ? username : '' %>"
                            class="flex items-center gap-3 px-4 py-2.5 text-gray-300 text-sm hover:bg-gray-800 hover:text-white transition-colors">
                            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <circle cx="12" cy="8" r="4"/>
                                <path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/>
                            </svg>
                            My Profile
                        </a>

                        <a href="/dashboard"
                            class="flex items-center gap-3 px-4 py-2.5 text-gray-300 text-sm hover:bg-gray-800 hover:text-white transition-colors">
                            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <rect x="3" y="3" width="7" height="7"/>
                                <rect x="14" y="3" width="7" height="7"/>
                                <rect x="3" y="14" width="7" height="7"/>
                                <rect x="14" y="14" width="7" height="7"/>
                            </svg>
                            Dashboard
                        </a>
                    </div>

                    <!-- Logout -->
                    <div class="border-t border-gray-800 py-1">
                        <a href="/logout"
                            class="flex items-center gap-3 px-4 py-2.5 text-red-400 text-sm hover:bg-gray-800 transition-colors">
                            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
                                <polyline points="16,17 21,12 16,7"/>
                                <line x1="21" y1="12" x2="9" y2="12"/>
                            </svg>
                            Logout
                        </a>
                    </div>
                </div>
            </div>

        </div>
    </div>
</header>

<script>
    let dropdownOpen = false;
    let profileMenuOpen = false;

    function toggleNotifications() {
        dropdownOpen = !dropdownOpen;
        const dropdown = document.getElementById('notif-dropdown');
        if (dropdownOpen) {
            // close profile menu
            document.getElementById('profile-dropdown').classList.add('hidden');
            profileMenuOpen = false;
            dropdown.classList.remove('hidden');
            loadNotifications();
        } else {
            dropdown.classList.add('hidden');
        }
    }

    function toggleProfileMenu() {
        profileMenuOpen = !profileMenuOpen;
        const dropdown = document.getElementById('profile-dropdown');
        if (profileMenuOpen) {
            // close notifications
            document.getElementById('notif-dropdown').classList.add('hidden');
            dropdownOpen = false;
            dropdown.classList.remove('hidden');
        } else {
            dropdown.classList.add('hidden');
        }
    }

    // Close both dropdowns when clicking outside
    document.addEventListener('click', function(e) {
        const notifWrapper = document.getElementById('notif-wrapper');
        const profileWrapper = document.getElementById('profile-wrapper');

        if (notifWrapper && !notifWrapper.contains(e.target)) {
            document.getElementById('notif-dropdown').classList.add('hidden');
            dropdownOpen = false;
        }
        if (profileWrapper && !profileWrapper.contains(e.target)) {
            document.getElementById('profile-dropdown').classList.add('hidden');
            profileMenuOpen = false;
        }
    });

    async function loadNotifications() {
        try {
            const res = await fetch('/notifications');
            const data = await res.json();
            const list = document.getElementById('notif-list');

            if (data.notifications.length === 0) {
                list.innerHTML = `
                    <div class="text-center py-8">
                        <p class="text-2xl mb-2">🔔</p>
                        <p class="text-gray-500 text-sm">No notifications yet</p>
                    </div>`;
                return;
            }

            list.innerHTML = data.notifications.map(n => `
                <a href="/topics/${n.topic}"
                    onclick="markOneRead(event, '${n._id}', '${n.topic}')"
                    class="block px-4 py-3 border-b border-gray-800 hover:bg-gray-800 transition-colors">
                    <div class="flex items-start gap-3">
                        <div class="mt-1 w-2 h-2 rounded-full flex-shrink-0 ${n.isRead ? 'bg-gray-600' : 'bg-teal-500'}"
                            id="dot-${n._id}"></div>
                        <div class="flex-1">
                            <p class="text-sm ${n.isRead ? 'text-gray-500' : 'text-gray-200'}"
                                id="text-${n._id}">${n.message}</p>
                            <p class="text-gray-600 text-xs mt-1">
                                ${new Date(n.createdAt).toLocaleString()}
                            </p>
                        </div>
                    </div>
                </a>
            `).join('');

        } catch(err) {
            document.getElementById('notif-list').innerHTML =
                '<p class="text-gray-500 text-sm text-center py-6">Could not load notifications</p>';
        }
    }

    async function markAllRead() {
        try {
            await fetch('/notifications/read', { method: 'POST' });
            const badge = document.getElementById('notif-badge');
            badge.classList.add('hidden');
            badge.textContent = '';
            loadNotifications();
        } catch(err) {
            console.log('Error marking as read');
        }
    }

    async function markOneRead(event, notifId, topicId) {
        event.preventDefault();
        try {
            await fetch(`/notifications/${notifId}/read`, { method: 'POST' });
            const dot = document.getElementById(`dot-${notifId}`);
            const text = document.getElementById(`text-${notifId}`);
            if (dot) {
                dot.classList.remove('bg-teal-500');
                dot.classList.add('bg-gray-600');
            }
            if (text) {
                text.classList.remove('text-gray-200');
                text.classList.add('text-gray-500');
            }
            const badge = document.getElementById('notif-badge');
            let current = parseInt(badge.textContent) || 0;
            current = Math.max(0, current - 1);
            if (current > 0) {
                badge.textContent = current;
            } else {
                badge.classList.add('hidden');
                badge.textContent = '';
            }
        } catch(err) {
            console.log('Error marking as read');
        }
        window.location.href = `/topics/${topicId}`;
    }

    setInterval(async () => {
        try {
            const res = await fetch('/notifications');
            const data = await res.json();
            const unread = data.notifications.filter(n => !n.isRead).length;
            const badge = document.getElementById('notif-badge');
            if (unread > 0) {
                badge.classList.remove('hidden');
                badge.textContent = unread;
            } else {
                badge.classList.add('hidden');
                badge.textContent = '';
            }
        } catch(err) {
            console.log('Polling error');
        }
    }, 15000);

    // Convert all timestamps to local timezone
    function formatLocalTime(dateString) {
         return new Date(dateString).toLocaleString(undefined, {
        year: 'numeric',
        month: 'numeric',
        day: 'numeric',
        hour: 'numeric',
        minute: '2-digit',
        second: '2-digit',
        hour12: true
    });
    }
// Auto convert all elements with data-time attribute
    function convertAllTimes() {
     document.querySelectorAll('[data-time]').forEach(el => {
         const raw = el.getAttribute('data-time');
        if (raw) el.textContent = formatLocalTime(raw);
     });
    }
// Run on page load
document.addEventListener('DOMContentLoaded', convertAllTimes);
</script>
